# Dominio público que apunta al servidor. Caddy obtendrá el certificado HTTPS.
APP_ADDRESS=chef.example.com

# Modelo descargado automáticamente en el volumen persistente de Ollama.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m

# Puedes fijar versiones concretas después de validarlas en tu servidor.
OLLAMA_IMAGE=ollama/ollama:latest
CADDY_IMAGE=caddy:2-alpine
APP_IMAGE=effiwaste-ai-chef:local

# Descomenta en un servidor con NVIDIA Container Toolkit para que deploy.sh use la GPU.
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml
