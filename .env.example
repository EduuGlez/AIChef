# Puerto local del servidor al que Nginx enviará las peticiones.
# Se enlaza exclusivamente a 127.0.0.1, nunca a la IP pública.
APP_PORT=3100

# Crea la clave en https://platform.openai.com/api-keys.
# Nunca subas el archivo .env al repositorio.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-terra

# Opcionales para cuentas que necesiten seleccionar organización o proyecto.
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=

APP_IMAGE=effiwaste-ai-chef:local
